<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <!-- Una paleta corta y oscura. Un solo color de acento. -->
    <Color x:Key="Ground">#0F1115</Color>
    <Color x:Key="Panel">#171A20</Color>
    <Color x:Key="Line">#262A33</Color>
    <Color x:Key="Text">#E8E8EA</Color>
    <Color x:Key="Muted">#9AA0AA</Color>
    <Color x:Key="Faint">#5C626D</Color>
    <Color x:Key="Accent">#4ADE80</Color>
    <Color x:Key="Danger">#F87171</Color>
    <Color x:Key="Warn">#F5A524</Color>

    <SolidColorBrush x:Key="GroundBrush" Color="{StaticResource Ground}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource Panel}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource Line}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Text}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}" />
    <SolidColorBrush x:Key="FaintBrush" Color="{StaticResource Faint}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource Warn}" />
  </Styles.Resources>

  <!-- Título grande de la marca -->
  <Style Selector="TextBlock.brand">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="LetterSpacing" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Campos de texto -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="42" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>

  <!--
    El ojito que muestra la contraseña. Va adentro del campo con
    TextBox.InnerRightContent, que es una propiedad del propio TextBox y no un
    Grid encima: así el texto nunca se mete abajo del botón.

    El ícono es un Path y no un carácter a propósito. El ojo de Unicode (U+1F441)
    está en el plano 1 y sale como un cuadrado vacío si la fuente del sistema no lo
    trae, que es el mismo motivo por el que los símbolos del servidor son todos del
    plano 0. Dibujado no depende de ninguna fuente.

    Focusable en false para que el Tab siga yendo de un campo al siguiente y no se
    quede en el botón.
  -->
  <Style Selector="ToggleButton.ojo">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,0,4,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
          <Panel Width="20" Height="20">
            <!-- Tapada: se ve el ojo, que invita a mirar. -->
            <Path Name="PART_Ojo"
                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round"
                  Data="M 1.7,10 C 3.6,6.2 6.6,4.3 10,4.3 C 13.4,4.3 16.4,6.2 18.3,10
                        C 16.4,13.8 13.4,15.7 10,15.7 C 6.6,15.7 3.6,13.8 1.7,10 Z
                        M 12.4,10 A 2.4,2.4 0 1 1 7.6,10 A 2.4,2.4 0 1 1 12.4,10 Z" />
            <!-- Mostrándose: el mismo ojo tachado. -->
            <Path Name="PART_OjoTachado" IsVisible="False"
                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round"
                  Data="M 1.7,10 C 3.6,6.2 6.6,4.3 10,4.3 C 13.4,4.3 16.4,6.2 18.3,10
                        C 16.4,13.8 13.4,15.7 10,15.7 C 6.6,15.7 3.6,13.8 1.7,10 Z
                        M 12.4,10 A 2.4,2.4 0 1 1 7.6,10 A 2.4,2.4 0 1 1 12.4,10 Z
                        M 3.4,3.4 L 16.6,16.6" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.ojo:checked /template/ Path#PART_Ojo">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ToggleButton.ojo:checked /template/ Path#PART_OjoTachado">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="ToggleButton.ojo:pointerover">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <!-- Botón principal -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="#0F1115" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="20,12" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#6EE7A0" />
    <Setter Property="TextElement.Foreground" Value="#0F1115" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="#2A3B31" />
    <Setter Property="TextElement.Foreground" Value="#6B7280" />
  </Style>

  <!-- El botón JUGAR, más grande -->
  <Style Selector="Button.play">
    <Setter Property="FontSize" Value="19" />
    <Setter Property="Padding" Value="0,18" />
    <Setter Property="LetterSpacing" Value="1" />
  </Style>

  <!-- Botón secundario -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
  </Style>

  <!-- Enlaces -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter">
    <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Enlaces de las redes: más chicos y tenues que el resto -->
  <Style Selector="Button.social">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
    <Setter Property="Padding" Value="6,2" />
  </Style>
  <Style Selector="Button.social:pointerover /template/ ContentPresenter">
    <Setter Property="TextElement.Foreground" Value="{StaticResource AccentBrush}" />
  </Style>

  <!-- Tarjeta -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="28" />
  </Style>

  <!-- Barra de progreso -->
  <Style Selector="ProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="{StaticResource LineBrush}" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>

</Styles>
