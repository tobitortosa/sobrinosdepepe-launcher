<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SobrinosDePepe.App.ViewModels"
             xmlns:core="using:SobrinosDePepe.Core"
             x:Class="SobrinosDePepe.App.Views.AdminView"
             x:DataType="vm:AdminViewModel">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24,22">

    <!-- Encabezado y pestañas -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
      <Button Grid.Column="0" Classes="link" Content="‹ Volver" Command="{Binding BackCommand}" />
      <TextBlock Grid.Column="1" Classes="title" Text="Administración" HorizontalAlignment="Center" />
    </Grid>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,18,0,14">
      <Button Classes="ghost" Command="{Binding ShowUsersCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Usuarios" />
          <Border Background="{StaticResource WarnBrush}" CornerRadius="9" Padding="6,1"
                  IsVisible="{Binding PendingCount}">
            <TextBlock Text="{Binding PendingCount}" FontSize="11" Foreground="#0F1115" FontWeight="SemiBold" />
          </Border>
        </StackPanel>
      </Button>
      <Button Classes="ghost" Content="Mods" Command="{Binding ShowModsCommand}" />
      <Button Classes="ghost" Command="{Binding ShowServerCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Servidor" />
          <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{StaticResource WarnBrush}"
                   IsVisible="{Binding ServerNeedsUpload}" />
        </StackPanel>
      </Button>
      <Button Classes="ghost" Content="Mis mods" Command="{Binding ShowMyModsCommand}" />
    </StackPanel>

    <!-- USUARIOS -->
    <Grid Grid.Row="2" RowDefinitions="Auto,*" IsVisible="{Binding ShowingUsers}">

      <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,12">
        <TextBlock Classes="faint" Text="{Binding OnlineSummary}" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" Text="{Binding Search}" PlaceholderText="Buscar por nombre" />
          <Button Grid.Column="1" Classes="ghost" Content="Buscar" Margin="8,0,0,0"
                  Command="{Binding LoadUsersCommand}" />
        </Grid>
      </StackPanel>

      <ScrollViewer Grid.Row="1">
        <ItemsControl ItemsSource="{Binding Users}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:UserRow">
              <Border Classes="card" Padding="14" Margin="0,0,0,8">
                <Grid ColumnDefinitions="Auto,*,Auto">

                  <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                           Fill="{Binding Dot}" />

                  <StackPanel Grid.Column="1" Margin="12,0" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Username}" Foreground="{StaticResource TextBrush}"
                                 FontSize="14" FontWeight="SemiBold" />
                      <TextBlock Text="admin" Classes="faint" VerticalAlignment="Center"
                                 IsVisible="{Binding IsAdmin}" />
                    </StackPanel>
                    <TextBlock Classes="faint">
                      <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} · {1:dd/MM/yyyy}">
                          <Binding Path="StatusLabel" />
                          <Binding Path="CreatedAt" />
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                  </StackPanel>

                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <Button Classes="ghost" Content="Aprobar" Padding="10,6" FontSize="12"
                            IsVisible="{Binding CanApprove}"
                            Command="{Binding $parent[ItemsControl].((vm:AdminViewModel)DataContext).ApproveCommand}"
                            CommandParameter="{Binding}" />
                    <Button Classes="ghost" Content="Banear" Padding="10,6" FontSize="12"
                            IsVisible="{Binding CanBan}"
                            Command="{Binding $parent[ItemsControl].((vm:AdminViewModel)DataContext).BanCommand}"
                            CommandParameter="{Binding}" />
                    <Button Classes="ghost" Content="Desbanear" Padding="10,6" FontSize="12"
                            IsVisible="{Binding CanUnban}"
                            Command="{Binding $parent[ItemsControl].((vm:AdminViewModel)DataContext).UnbanCommand}"
                            CommandParameter="{Binding}" />
                    <Button Classes="ghost" Content="Clave" Padding="10,6" FontSize="12"
                            IsVisible="{Binding CanResetPassword}"
                            Command="{Binding $parent[ItemsControl].((vm:AdminViewModel)DataContext).ResetPasswordCommand}"
                            CommandParameter="{Binding}" />
                  </StackPanel>

                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

    </Grid>

    <!-- MODS -->
    <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto" IsVisible="{Binding ShowingMods}">

      <StackPanel Grid.Row="0" Margin="0,0,0,12" Spacing="4">
        <TextBlock Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold"
                   Text="{Binding PackVersion, StringFormat='Pack de mods {0}'}" />
        <TextBlock Classes="faint" Text="{Binding PackInfo}" />
        <TextBlock Classes="faint" Text="{Binding ServerSideNote}"
                   IsVisible="{Binding ServerSideNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>

      <ScrollViewer Grid.Row="1">
        <ItemsControl ItemsSource="{Binding Mods}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="core:AdminMod">
              <Border Classes="card" Padding="12,10" Margin="0,0,0,6">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="13" />
                    <TextBlock Classes="faint">
                      <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} · {1} · {2}">
                          <Binding Path="VersionNumber" />
                          <Binding Path="SideLabel" />
                          <Binding Path="SizeLabel" />
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Classes="faint" Text="{Binding License}"
                             VerticalAlignment="Center" Margin="0,0,10,0"
                             MaxWidth="120" TextTrimming="CharacterEllipsis" />
                  <Button Grid.Column="2" Classes="link" Content="✕" FontSize="14"
                          Command="{Binding $parent[ItemsControl].((vm:AdminViewModel)DataContext).RemoveModCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel Grid.Row="2" Spacing="10" Margin="0,14,0,0">
        <Button Classes="ghost" Content="+ Subir mods (.jar)" HorizontalAlignment="Stretch"
                Command="{Binding AddModsCommand}" />
        <Button Classes="primary" HorizontalAlignment="Stretch"
                Command="{Binding PublishCommand}"
                Content="PUBLICAR PARA TODOS" />
        <TextBlock Classes="faint" TextAlignment="Center" TextWrapping="Wrap"
                   IsVisible="{Binding HasUnpublishedChanges}"
                   Text="Hay cambios sin publicar. Hasta que publiques, los jugadores siguen con el pack anterior." />
      </StackPanel>

    </Grid>

    <!-- SERVIDOR -->
    <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto" IsVisible="{Binding ShowingServer}">

      <StackPanel Grid.Row="0" Margin="0,0,0,12" Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold"
                     Text="El servidor está" VerticalAlignment="Center" />
          <Ellipse Width="8" Height="8" VerticalAlignment="Center">
            <Ellipse.Fill>
              <SolidColorBrush Color="{Binding ServerOnline, Converter={StaticResource StatusColor}}" />
            </Ellipse.Fill>
          </Ellipse>
          <TextBlock Text="{Binding ServerState}" FontSize="14" FontWeight="SemiBold"
                     Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Classes="faint" Text="{Binding ServerModsSummary}" />
        <TextBlock Classes="faint" TextWrapping="Wrap"
                   Text="Los mods de solo cliente no van acá: el servidor los ignora." />
      </StackPanel>

      <ScrollViewer Grid.Row="1">
        <StackPanel Spacing="6">

          <TextBlock Classes="label" Text="FALTAN EN EL SERVIDOR" Margin="0,4,0,2"
                     IsVisible="{Binding ServerNeedsUpload}" />
          <ItemsControl ItemsSource="{Binding ServerMissing}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="core:ServerMod">
                <Border Classes="card" Padding="12,10" Margin="0,0,0,6">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource WarnBrush}" FontSize="13" />
                    <TextBlock Classes="faint" Text="{Binding Filename}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="label" Text="ESTÁN EN EL SERVIDOR Y NO EN EL PACK" Margin="0,10,0,2"
                     IsVisible="{Binding ServerHasExtra}" />
          <ItemsControl ItemsSource="{Binding ServerExtra}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="x:String">
                <Border Classes="card" Padding="12,10" Margin="0,0,0,6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding}" Classes="muted" FontSize="12"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Classes="link" Content="Borrar" FontSize="12"
                            Command="{Binding $parent[ItemsControl].((vm:AdminViewModel)DataContext).RemoveServerModCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Row="2" Spacing="10" Margin="0,14,0,0">
        <Button Classes="primary" Content="SUBIR LOS QUE FALTAN" HorizontalAlignment="Stretch"
                IsVisible="{Binding ServerNeedsUpload}"
                Command="{Binding UploadServerModsCommand}" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <Button Classes="ghost" Content="Reiniciar el servidor" Command="{Binding RestartServerCommand}" />
          <Button Classes="ghost" Content="Actualizar" Command="{Binding LoadServerModsCommand}" />
        </StackPanel>
      </StackPanel>

    </Grid>

    <!-- MIS MODS -->
    <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto" IsVisible="{Binding ShowingMyMods}">

      <StackPanel Grid.Row="0" Margin="0,0,0,12" Spacing="4">
        <TextBlock Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold"
                   Text="Mis mods" />
        <TextBlock Classes="faint" TextWrapping="Wrap" Text="{Binding MyModsSummary}" />
        <TextBlock Classes="faint" TextWrapping="Wrap"
                   Text="No se publican: nadie más los recibe. Y son solo para tu cuenta de admin, que es lo que evita que cualquiera se meta un mod en la carpeta." />
      </StackPanel>

      <ScrollViewer Grid.Row="1">
        <ItemsControl ItemsSource="{Binding MyMods}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="core:MyMod">
              <Border Classes="card" Padding="12,10" Margin="0,0,0,6">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="13" />
                    <TextBlock Classes="faint">
                      <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} · {1}">
                          <Binding Path="VersionNumber" />
                          <Binding Path="SizeLabel" />
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                  </StackPanel>
                  <Button Grid.Column="1" Classes="link" Content="✕" FontSize="14"
                          Command="{Binding $parent[ItemsControl].((vm:AdminViewModel)DataContext).RemoveMyModCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel Grid.Row="2" Spacing="10" Margin="0,14,0,0">
        <Button Classes="ghost" Content="+ Agregar un mod para mí (.jar)" HorizontalAlignment="Stretch"
                Command="{Binding AddMyModsCommand}" />
        <TextBlock Classes="faint" TextAlignment="Center" TextWrapping="Wrap"
                   Text="Se instalan al apretar JUGAR, en cualquier computadora donde entres con tu cuenta." />
      </StackPanel>

    </Grid>


    <!-- Pie: confirmación y mensajes -->
    <StackPanel Grid.Row="3" Margin="0,14,0,0" Spacing="8">

      <Border Classes="card" Padding="14"
              IsVisible="{Binding ConfirmText, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="12">
          <TextBlock Classes="muted" Text="{Binding ConfirmText}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="ghost" Content="No" Command="{Binding CancelConfirmCommand}" />
            <Button Classes="primary" Content="Sí, dale" Padding="16,8" Command="{Binding ConfirmCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Classes="error" Text="{Binding Error}"
                 IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Classes="muted" Text="{Binding Notice}" TextWrapping="Wrap"
                 IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
    </StackPanel>

  </Grid>
</UserControl>
