<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SobrinosDePepe.App.ViewModels"
             x:Class="SobrinosDePepe.App.Views.ChangePasswordView"
             x:DataType="vm:ChangePasswordViewModel">

  <Grid RowDefinitions="*,Auto,*" Margin="34">

    <StackPanel Grid.Row="1" Spacing="0">

      <Image Source="avares://SobrinosDePepe/Assets/logo.png"
             Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,18" />

      <TextBlock Classes="title" Text="Elegí tu contraseña" HorizontalAlignment="Center" />

      <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,24"
                 Text="{Binding Username, StringFormat='Entraste como {0} con la contraseña provisoria. Poné una tuya: nadie más va a saberla, ni el administrador.'}" />

      <TextBlock Classes="label" Text="Contraseña nueva" />
      <TextBox Text="{Binding Password}" PasswordChar="&#x2022;"
               RevealPassword="{Binding MostrarContrasena}">
        <TextBox.InnerRightContent>
          <ToggleButton Classes="ojo" IsChecked="{Binding MostrarContrasena}"
                        ToolTip.Tip="Mostrar u ocultar la contraseña" />
        </TextBox.InnerRightContent>
      </TextBox>

      <TextBlock Classes="label" Text="Repetila" Margin="0,16,0,6" />
      <TextBox Text="{Binding Confirm}" PasswordChar="&#x2022;"
               RevealPassword="{Binding MostrarContrasena}">
        <TextBox.InnerRightContent>
          <ToggleButton Classes="ojo" IsChecked="{Binding MostrarContrasena}"
                        ToolTip.Tip="Mostrar u ocultar la contraseña" />
        </TextBox.InnerRightContent>
      </TextBox>

      <TextBlock Classes="error" Text="{Binding Error}" Margin="0,16,0,0"
                 IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <Button Classes="primary" Content="GUARDAR"
              Command="{Binding SaveCommand}"
              IsEnabled="{Binding !IsBusy}"
              HorizontalAlignment="Stretch" Margin="0,24,0,0" />

      <Button Classes="link" Content="Cerrar sesión"
              Command="{Binding LogOutCommand}"
              HorizontalAlignment="Center" Margin="0,12,0,0" />

    </StackPanel>

  </Grid>
</UserControl>
