<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SobrinosDePepe.App.ViewModels"
             x:Class="SobrinosDePepe.App.Views.PendingView"
             x:DataType="vm:PendingViewModel">

  <Grid RowDefinitions="*,Auto,*" Margin="34">

    <StackPanel Grid.Row="1" Spacing="0">

      <Image Source="avares://SobrinosDePepe/Assets/logo.png"
             Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,18" />
      <TextBlock Classes="brand" Text="SOBRINOS DE PEPE" Margin="0,0,0,28" />

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="title" Text="Falta un paso" HorizontalAlignment="Center" />
          <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                     Text="{Binding Username, StringFormat='Tu cuenta {0} ya está creada, pero justo ahora no pude avisarle al servidor. Esta pantalla cambia sola cuando se destrabe: podés esperar o cerrar y volver a entrar. Si tarda, avisale al administrador.'}" />
        </StackPanel>
      </Border>

      <TextBlock Classes="error" Text="{Binding Error}" Margin="0,16,0,0" TextAlignment="Center"
                 IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <Button Classes="ghost" Content="Volver a comprobar"
              Command="{Binding CheckCommand}"
              IsEnabled="{Binding !IsChecking}"
              HorizontalAlignment="Center" Margin="0,22,0,0" />

      <Button Classes="link" Content="Cerrar sesión"
              Command="{Binding LogOutCommand}"
              HorizontalAlignment="Center" Margin="0,12,0,0" />

    </StackPanel>

  </Grid>
</UserControl>
