    {
      "slot": [
        2,
        5
      ],
      "type": "item",
      "item": {
        "id": "minecraft:white_banner",
        "count": 1,
        "components": {
          "minecraft:custom_name": {
            "text": "QUE ES UN EQUIPO",
            "italic": false,
            "color": "#55ff7f",
            "bold": true
          },
          "minecraft:lore": [
            {
              "text": "  Un equipo son hasta 6 que andan juntos",
              "italic": false,
              "color": "gray"
            },
            {
              "text": "",
              "italic": false
            },
            {
              "text": "  ▪ Entre companeros NO se pegan",
              "italic": false,
              "color": "#55ff7f"
            },
            {
              "text": "  ▪ Se ven en la barra de arriba",
              "italic": false,
              "color": "#55ff7f"
            },
            {
              "text": "  ▪ El nombre va del color del equipo",
              "italic": false,
              "color": "#55ff7f"
            },
            {
              "text": "",
              "italic": false
            },
            {
              "text": "  Al que no es de tu equipo no lo ves en esa",
              "italic": false,
              "color": "gray"
            },
            {
              "text": "  barra, y el tampoco te ve a vos.",
              "italic": false,
              "color": "gray"
            },
            {
              "text": "",
              "italic": false
            },
            {
              "text": "  Al que invitas le llega un boton para entrar",
              "italic": false,
              "color": "gray"
            },
            {
              "text": "  y le dura 2 minutos. Invitar y echar los",
              "italic": false,
              "color": "gray"
            },
            {
              "text": "  hace el jefe, que es el que armo el equipo.",
              "italic": false,
              "color": "gray"
            }
          ],
          "minecraft:tooltip_display": {
            "hidden_components": [
              "minecraft:attribute_modifiers",
              "minecraft:potion_contents",
              "minecraft:unbreakable",
              "minecraft:stored_enchantments",
              "minecraft:enchantments"
            ]
          },
          "minecraft:custom_data": {
            "sdp": "menu"
          }
        }
      },
      "sound": "click"
    },
