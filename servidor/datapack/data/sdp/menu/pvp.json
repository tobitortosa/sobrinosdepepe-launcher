    {
      "slot": [
        2,
        5
      ],
      "type": "item",
      "item": {
        "id": "minecraft:netherite_chestplate",
        "count": 1,
        "components": {
          "minecraft:custom_name": {
            "text": "☠ COMO SE PELEA ACA",
            "italic": false,
            "color": "#ff0000",
            "bold": true
          },
          "minecraft:lore": [
            {
              "text": "  El PvP esta activo en TODO el mundo",
              "italic": false,
              "color": "#ff5555"
            },
            {
              "text": "",
              "italic": false
            },
            {
              "text": "  ▪ Si te matan, perdes lo que llevas",
              "italic": false,
              "color": "gray"
            },
            {
              "text": "  ▪ Quien te mata se lleva el 10% de tu plata",
              "italic": false,
              "color": "gray"
            },
            {
              "text": "  ▪ Las bases NO estan protegidas",
              "italic": false,
              "color": "gray"
            },
            {
              "text": "  ▪ Peleando no se puede viajar",
              "italic": false,
              "color": "gray"
            },
            {
              "text": "",
              "italic": false
            },
            {
              "text": "  Desde que le pegas a alguien o te pegan quedas",
              "italic": false,
              "color": "#ff5555"
            },
            {
              "text": "  EN PELEA por 15 segundos, y ahi no andan",
              "italic": false,
              "color": "#ff5555"
            },
            {
              "text": "  /home, /spawn, /rtp, /back ni /tpa.",
              "italic": false,
              "color": "#ff5555"
            },
            {
              "text": "",
              "italic": false
            },
            {
              "text": "  Lo que guardas en el ender chest no se",
              "italic": false,
              "color": "gray"
            },
            {
              "text": "  pierde al morir y nadie te lo puede robar.",
              "italic": false,
              "color": "gray"
            },
            {
              "text": "",
              "italic": false
            },
            {
              "text": "  Con /equipo armas equipo: entre companeros",
              "italic": false,
              "color": "#55ff7f"
            },
            {
              "text": "  no se pegan, y se ven en la barra de arriba.",
              "italic": false,
              "color": "#55ff7f"
            }
          ],
          "minecraft:tooltip_display": {
            "hidden_components": [
              "minecraft:attribute_modifiers",
              "minecraft:potion_contents",
              "minecraft:unbreakable",
              "minecraft:stored_enchantments",
              "minecraft:enchantments"
            ]
          },
          "minecraft:custom_data": {
            "sdp": "menu"
          }
        }
      },
      "sound": "click"
    },
