# Postgres. En Neon: Dashboard -> Connection string (con ?sslmode=require).
DATABASE_URL=postgres://usuario:clave@host/base?sslmode=require

# Panel de Minehost. La clave se crea en el panel, en Cuenta -> Credenciales de API.
# Da control total del servidor: nunca la pongas en el launcher ni la subas al repo.
PTERODACTYL_KEY=ptlc_...
PTERODACTYL_URL=https://pterodactyl.minehost.com.ar
PTERODACTYL_SERVER_ID=dbd3f1e9

# Tu cuenta de administrador. La contraseña la elegís acá y solo la sabés vos:
# este archivo es local y no se sube al repositorio. Cada vez que corras
# "npm run db:seed" se aplica lo que pongas.
ADMIN_USERNAME=PEPE
ADMIN_PASSWORD=

# Los jugadores que ya están en el servidor, separados por comas. Reciben una
# contraseña al azar la primera vez y el script la imprime.
# La contraseña provisoria: la que queda cuando restablecés la de alguien. Entra con
# ella y el launcher le pide elegir la suya.
DEFAULT_PASSWORD=pepe2026

PLAYERS=Chichon,Titit0N,Luquitas1410,Felix_1256

# El pack
MINECRAFT_VERSION=26.1
FABRIC_LOADER=0.19.5
SERVER_NAME=SOBRINOS DE PEPE
SERVER_ADDRESS=sobrinosdepepe.minehost.pro

# User-Agent que exigen los términos de uso de la API de Modrinth
MODRINTH_USER_AGENT=SobrinosDePepeLauncher/0.1 (tu-email)

# La netherita: en true no se puede fabricar (las doce recetas de la mesa de
# herrería quedan apagadas) y sale solo de la tienda de shards, o sea matando
# jugadores. En false es normal y se craftea minando. Lo aplica al servidor
# "python servidor/configurar-netherite.py", que hay que volver a correr al
# cambiarlo.
RESTRICT_NETHERITE=false

# El candado: en true, al servidor no entra nadie que no haya abierto el juego con
# el launcher (ve un cartel con la dirección de acá abajo). En false queda como
# antes —entra cualquiera— pero el servidor igual anota en su log quién entró sin
# el launcher. Lo copia al servidor "python servidor/subir-acceso.py", que hay que
# volver a correr cada vez que se cambie.
REQUIRE_LAUNCHER=false

# Con esto se firman los permisos de entrada al servidor: sin uno, el mod del
# servidor no deja entrar. El mismo valor va en la config del servidor, y lo pone
# ahí "python servidor/subir-acceso.py". Se genera con:
#   python -c "import secrets; print(secrets.token_hex(32))"
ACCESS_SECRET=

# La dirección de la página, tal como la ve quien intenta entrar sin el launcher.
# Está acá para que el día que compremos un dominio se cambie en un solo lugar.
SITE_URL=sobrinosdepepe.vercel.app

# Link al Setup.exe para la página de descarga (GitHub Releases)
DOWNLOAD_URL=
